# Unity reverse-engineering raw captures can be hundreds of MB.
# Keep derived summaries/reports in git, leave raw probe grids and browser dumps local.
log/unity_*/
log/unity_*.json
log/*_screen*.png
data/calibration/unity_physx_collision_probe_*.json
data/calibration/unity_cooked_hulls_*.json

# Archived Unity reverse-engineering raw captures are local evidence, not Git
# content.  They total multiple GB; the archived source, docs, tests and small
# configuration manifests remain versioned.
research_archive/unity_reverse/evidence/log/
research_archive/unity_reverse/evidence/data/

# Generated planner/training reports are reproducible outputs, not source.
local_simulator/runs/
planning_proxy/runs/
training_research/runs/
training_research/benchmarks/runs/

# Downloaded World Curling results books and derived page extracts are local
# research evidence (~150 MB). Keep the reproducible extractor, README and
# small game index under training_data/gushue_shotbook/ in Git instead.
training_data/gushue_shotbook/source_results_books/
training_data/gushue_shotbook/extracted_text/
training_data/gushue_shotbook/gushue_games/
training_data/gushue_shotbook/diagnostics/
training_data/gushue_shotbook/coordinates/

